function Section:CreateSlider(config)
    config = config or {}
    local min, max = tonumber(config.Min or 0) or 0, tonumber(config.Max or 100) or 100
    if max < min then min, max = max, min end
    local range = max - min
    local current = math.clamp(tonumber(config.Default or min) or min, min, max)
    local outer, core = controlRow(self, config.Name or "Slider", 56)
    local title = label(core, config.Name or "Slider", 11, C.ivory)
    title.Position = UDim2.fromOffset(16, 4); title.Size = UDim2.new(0.55, 0, 0, 22); title.ZIndex = 3
    local value = label(core, tostring(current), 10, C.primary, FONT_TITLE)
    value.Position = UDim2.new(0.55, 0, 0, 4); value.Size = UDim2.new(0.45, -16, 0, 22); value.TextXAlignment = Enum.TextXAlignment.Right; value.ZIndex = 3
    local track = make("Frame", { BackgroundColor3 = C.trackOff, BorderSizePixel = 0, ClipsDescendants = true, Position = UDim2.fromOffset(16, 33), Size = UDim2.new(1, -32, 0, 7), ZIndex = 3 }, core)
    corner(track, 4)
    local fillAlpha = range > 0 and math.clamp((current - min) / range, 0, 1) or 0
    local fill = make("Frame", { BackgroundColor3 = C.primary, BorderSizePixel = 0, Size = UDim2.new(fillAlpha,0,1,0), ZIndex = 4 }, track)
    corner(fill, 4); themeGradient(fill, "primary", 0)
    local thumb = make("Frame", {
        BackgroundColor3 = C.onPrimary, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.new(fillAlpha,0,0.5,0), Size = UDim2.fromOffset(16,16), ZIndex = 5,
    }, track)
    corner(thumb, 8); stroke(thumb, C.primary, 0.1, 1)
    local hit = make("Frame", { Name = "HitArea", BackgroundTransparency = 1, Active = true, Position = UDim2.fromOffset(10, 20), Size = UDim2.new(1, -20, 0, 30), ZIndex = 10 }, core)
    local function setFromX(x, emit)
        local alpha = range > 0 and math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X,1), 0, 1) or 0
        local raw = min + range * alpha
        local step = tonumber(config.Step or config.Increment)
        if step and step > 0 and range > 0 then raw = min + math.round((raw - min) / step) * step end
        current = range > 0 and math.clamp(raw, min, max) or min
        local snappedAlpha = range > 0 and math.clamp((current - min) / range, 0, 1) or 0
        value.Text = tostring(current)
        fill.Size = UDim2.new(snappedAlpha,0,1,0)
        thumb.Position = UDim2.new(snappedAlpha,0,0.5,0)
        if emit and config.Callback then task.spawn(config.Callback, current) end
    end
    local sliding, slidePointer, slideUsesMouse = false, nil, false
    bindHover(hit, hoverLayer(core, C.hover, 19, 2, 0.94))
    local window = self._tab._window
    local began = hit.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        sliding = true; slidePointer = input; slideUsesMouse = input.UserInputType == Enum.UserInputType.MouseButton1
        setFromX(input.Position.X, true)
    end)
    table.insert(window._connections, began)
    table.insert(window._connections, UserInputService.InputChanged:Connect(function(input)
        if not sliding then return end
        if slideUsesMouse then
            if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        elseif input ~= slidePointer then return end
        setFromX(input.Position.X, true)
    end))
    table.insert(window._connections, UserInputService.InputEnded:Connect(function(input)
        if not sliding then return end
        local ownsRelease = slideUsesMouse and input.UserInputType == Enum.UserInputType.MouseButton1 or (not slideUsesMouse and input == slidePointer)
        if ownsRelease then sliding = false; slidePointer = nil end
    end))
    return {
        _frame = outer,
        Get = function() return current end,
        Set = function(_, v) setFromX(track.AbsolutePosition.X + track.AbsoluteSize.X * (range > 0 and math.clamp((tonumber(v) - min)/range,0,1) or 0), true) end,
    }
end

