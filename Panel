        _topHeight = topHeight, _bottomBarHeight = bottomBarHeight, _guiName = guiName, _headerPrefix = tostring(config.HeaderText or "WORKSPACE"),
    }, Window)
    table.insert(self._windows, window)

    local function applyPanelSize(size)
        currentSize = Vector2.new(math.clamp(size.X, minSize.X, maxSize.X), math.clamp(size.Y, minSize.Y, maxSize.Y))
        window._size = currentSize
        shell.Size = UDim2.fromOffset(currentSize.X, currentSize.Y)
        shadow.Size = UDim2.fromOffset(currentSize.X + 10, currentSize.Y + 10)
        launcher.Size = UDim2.fromOffset(window._launcherSize * (scale.Scale or 1), window._launcherSize * (scale.Scale or 1))
    end

    local function updateScale()
        local camera = workspace.CurrentCamera
        if not camera then return end
        local v = camera.ViewportSize
        local safeX, safeY = 18, 18
        scale.Scale = math.min(1, (v.X - safeX * 2) / currentSize.X, (v.Y - safeY * 2) / currentSize.Y)
        scale.Scale = math.max(0.36, scale.Scale)
        launcher.Size = UDim2.fromOffset(window._launcherSize * scale.Scale, window._launcherSize * scale.Scale)
    end
    local cameraConnection
    local function bindCamera()
        if cameraConnection then cameraConnection:Disconnect(); cameraConnection = nil end
        local camera = workspace.CurrentCamera
        if camera then
            updateScale()
            cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
        end
    end
    bindCamera()
    table.insert(window._connections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera))
    table.insert(window._connections, { Disconnect = function() if cameraConnection then cameraConnection:Disconnect() end end })

    -- WindUI-like drag: dedicated transparent drag zone keeps the buttons and tabs responsive.
    local dragging = false
    local dragStart, startPosition
    local function beginDrag(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true; dragStart = input.Position; startPosition = shell.Position
    end
    table.insert(window._connections, dragHit.InputBegan:Connect(beginDrag))
    table.insert(window._connections, bottomBar.InputBegan:Connect(beginDrag))
    table.insert(window._connections, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        local camera = workspace.CurrentCamera
        local viewportSize = camera and camera.ViewportSize or Vector2.new(1920,1080)
        local halfW, halfH = currentSize.X * scale.Scale * 0.5, currentSize.Y * scale.Scale * 0.5
        local px = math.clamp(startPosition.X.Offset + delta.X / math.max(scale.Scale, 0.01), -viewportSize.X/2 + halfW + 6, viewportSize.X/2 - halfW - 6)
        local py = math.clamp(startPosition.Y.Offset + delta.Y / math.max(scale.Scale, 0.01), -viewportSize.Y/2 + halfH + 6, viewportSize.Y/2 - halfH - 6)
        shell.Position = UDim2.new(0.5, px, 0.5, py)
        shadow.Position = shell.Position + UDim2.fromOffset(0, 7)
    end))
    table.insert(window._connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                window._openPosition = shell.Position
                dragging = false
            end
        end
    end))

    -- WindUI-like bottom-right live resize handle.
    local resizing, resizeStart, resizeBase, resizePointer, resizeMouse = false, nil, nil, nil, false
    table.insert(window._connections, resizeHandle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        resizing = true; resizeStart = input.Position; resizeBase = currentSize; resizePointer = input; resizeMouse = input.UserInputType == Enum.UserInputType.MouseButton1
    end))
    table.insert(window._connections, UserInputService.InputChanged:Connect(function(input)
        if not resizing then return end
        if resizeMouse then
            if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        elseif input ~= resizePointer then
            return
        end
        local delta = input.Position - resizeStart
        applyPanelSize(Vector2.new(resizeBase.X + delta.X / math.max(scale.Scale,0.01), resizeBase.Y + delta.Y / math.max(scale.Scale,0.01)))
        updateScale()
    end))
    table.insert(window._connections, UserInputService.InputEnded:Connect(function(input)
        if not resizing then return end
        local ownsRelease = resizeMouse and input.UserInputType == Enum.UserInputType.MouseButton1 or (not resizeMouse and input == resizePointer)
        if ownsRelease then resizing = false; resizePointer = nil; updateScale() end
    end))

    -- Launcher drag/open logic, with a dead-zone to avoid accidental opens while dragging.
    local launcherDragging, launcherMoved, launcherPointer, launcherUsesMouse = false, false, nil, false
    local launcherDragStart, launcherStartPosition = Vector2.zero, launcher.Position
    local function updateLauncherDrag(position)
        local delta = position - launcherDragStart
        if delta.Magnitude < 5 then return end
        launcherMoved = true
        local camera = workspace.CurrentCamera
        local viewportSize = camera and camera.ViewportSize or Vector2.new(1920,1080)
        local maxX = math.max(8, viewportSize.X - launcher.AbsoluteSize.X - 8)
        local maxY = math.max(8, viewportSize.Y - launcher.AbsoluteSize.Y - 8)
        launcher.Position = UDim2.fromOffset(
            math.clamp(launcherStartPosition.X.Offset + delta.X, 8, maxX),
            math.clamp(launcherStartPosition.Y.Offset + delta.Y, 8, maxY)
        )
    end
    table.insert(window._connections, launcher.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        launcherDragging = true; launcherMoved = false; launcherPointer = input; launcherUsesMouse = input.UserInputType == Enum.UserInputType.MouseButton1
        launcherDragStart = input.Position; launcherStartPosition = launcher.Position
    end))
    table.insert(window._connections, UserInputService.InputChanged:Connect(function(input)
        if not launcherDragging then return end
        if launcherUsesMouse then
            if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        elseif input ~= launcherPointer then return end
        updateLauncherDrag(input.Position)
    end))
    table.insert(window._connections, UserInputService.InputEnded:Connect(function(input)
        if not launcherDragging then return end
        local ownsRelease = launcherUsesMouse and input.UserInputType == Enum.UserInputType.MouseButton1 or (not launcherUsesMouse and input == launcherPointer)
        if not ownsRelease then return end
        updateLauncherDrag(input.Position); launcherDragging = false; launcherPointer = nil
        if not launcherMoved then window:Open() end
    end))

    table.insert(window._connections, UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == window._keybind and not UserInputService:GetFocusedTextBox() then window:Toggle() end
    end))
    bindActivation(close, function() window:Destroy() end)
    bindActivation(minimize, function() window:Minimize() end)

    applyPanelSize(currentSize); updateScale()
    launcher.Visible = false
    tween(shell, Motion.enter, { Position = UDim2.new(0.5, 0, 0.5, 0) })
    tween(shadow, Motion.enter, { BackgroundTransparency = 0.78, Position = UDim2.new(0.5, 0, 0.5, 7) })
    return window
end

function Window:_renderNavState()
    for _, item in ipairs(self._tabs) do
        local selected = item == self._active
        local hovered = item == self._hoveredTab and not selected
        animate(item._button, "nav", Motion.fast, {
            BackgroundColor3 = selected and C.primarySoft or C.lineSoft,
            BackgroundTransparency = (selected or hovered) and (selected and 0.05 or 0.35) or 1,
        })
        animate(item._label, "nav", Motion.fast, { TextColor3 = selected and C.primary2 or (hovered and C.ivory or C.secondary) })
        if item._iconScale then animate(item._iconScale, "nav", Motion.fast, { Scale = selected and 1.08 or 1 }) end
        setNavIconColor(item._iconParts, selected and C.primary or (hovered and C.secondary or C.muted))
    end
end

