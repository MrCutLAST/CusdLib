-- Legacy algorithm-rendered icons are intentionally retained only for the
-- window Close and Minimize controls. Everything else uses Lucide.
local ALGORITHM_ICON_ALPHA = {
    ["close"] = "",
    ["minimize"] = "",
}
local algorithmEditableImages = {}
local BASE64_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function decodeAlgorithmBase64(value)
    local output, accumulator, bits = {}, 0, 0
    for index = 1, #value do
        local char = value:sub(index, index)
        if char ~= "=" then
            local position = BASE64_ALPHABET:find(char, 1, true)
            if position then
                accumulator = accumulator * 64 + (position - 1)
                bits = bits + 6
                while bits >= 8 do
                    bits = bits - 8
                    output[#output + 1] = string.char(math.floor(accumulator / (2 ^ bits)) % 256)
                end
                accumulator = accumulator % (2 ^ bits)
            end
        end
    end
    return table.concat(output)
end

local function algorithmIcon(parent, name, position, size, zIndex, color)
    local encoded = ALGORITHM_ICON_ALPHA[name]
    if not encoded then return nil end
    if not buffer or type(buffer.create) ~= "function" or not AssetService then return nil end

    local alpha = decodeAlgorithmBase64(encoded)
    if #alpha < 48 * 48 then return nil end

    local ok, editable = pcall(function()
        return AssetService:CreateEditableImage({ Size = Vector2.new(48, 48) })
    end)
    if not ok or not editable then return nil end

    local okWrite = pcall(function()
        local pixels = buffer.create(48 * 48 * 4)
        for index = 1, 48 * 48 do
            local offset = (index - 1) * 4
            buffer.writeu8(pixels, offset, 255)
            buffer.writeu8(pixels, offset + 1, 255)
            buffer.writeu8(pixels, offset + 2, 255)
            buffer.writeu8(pixels, offset + 3, string.byte(alpha, index) or 0)
        end
        editable:WritePixelsBuffer(Vector2.zero, Vector2.new(48, 48), pixels)
    end)
    if not okWrite then
        pcall(function() editable:Destroy() end)
        return nil
    end

    algorithmEditableImages[#algorithmEditableImages + 1] = editable
    local okContent, content = pcall(function() return Content.fromObject(editable) end)
    if not okContent or not content then return nil end

    return make("ImageLabel", {
        Name = "AlgorithmIcon_" .. tostring(name),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Position = position or UDim2.fromScale(0, 0), Size = size or UDim2.fromScale(1, 1),
        ImageContent = content, ImageColor3 = color or C.secondary,
        ScaleType = Enum.ScaleType.Fit, ZIndex = zIndex or 12,
    }, parent)
end

