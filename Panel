function Section:AddParagraph(config)
    local titleText, contentText
    if type(config) == "table" then
        titleText = config.Title or config[1] or ""
        contentText = config.Content or config[2] or ""
    else
        titleText = ""
        contentText = config == nil and "" or tostring(config)
    end

    local frame = make("Frame", {
        Name = "Paragraph",
        LayoutOrder = nextOrder(self._tab),
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
    }, self._tab._scroll)
    make("UIListLayout", {
        Padding = UDim.new(0, 3),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, frame)
    local title = label(frame, tostring(titleText), 11, C.ivory, FONT_LABEL)
    title.LayoutOrder = 1
    title.Size = UDim2.new(1, 0, 0, 18)
    title.Visible = titleText ~= nil and tostring(titleText) ~= ""
    local content = label(frame, tostring(contentText), 10, C.secondary)
    content.LayoutOrder = 2
    content.Size = UDim2.new(1, 0, 0, 0)
    content.AutomaticSize = Enum.AutomaticSize.Y
    content.TextWrapped = true
    content.TextYAlignment = Enum.TextYAlignment.Top
    content.Visible = contentText ~= nil and tostring(contentText) ~= ""

    return {
        _frame = frame,
        Set = function(_, value)
            if type(value) == "table" then
                if value.Title ~= nil or value[1] ~= nil then
                    title.Text = tostring(value.Title or value[1] or "")
                    title.Visible = title.Text ~= ""
                end
                if value.Content ~= nil or value[2] ~= nil then
                    content.Text = tostring(value.Content or value[2] or "")
                    content.Visible = content.Text ~= ""
                end
            else
                content.Text = value == nil and "" or tostring(value)
                content.Visible = content.Text ~= ""
            end
        end,
    }
end

function Section:AddLine()
    local line = make("Frame", {
