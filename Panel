function Section:AddDropdown(config)
    config = config or {}
    local default = config.Default
    if config.Multi then
        if type(default) ~= "table" then default = default ~= nil and { default } or {} end
        return self:CreateMultiDropdown({
            Name = config.Title or config.Name or "Dropdown",
            Options = config.Options or {},
            Default = default,
            Callback = config.Callback,
        })
    end
    if type(default) == "table" then default = default[1] end
    return self:CreateDropdown({
        Name = config.Title or config.Name or "Dropdown",
        Options = config.Options or {},
        Default = default,
        Callback = config.Callback,
    })
end

