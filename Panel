    local page = make("CanvasGroup", {
        Name = name .. "Page", BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(14, 0),
        GroupTransparency = 1, Visible = false,
    }, self._content)
    local scroll = make("ScrollingFrame", {
