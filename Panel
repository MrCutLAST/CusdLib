local function loadLucideIcons()
    if lucideCache then return lucideCache end
    local cached = runtimeEnv.__CustomUILucideIcons
    if type(cached) == "table" then
        lucideCache = cached
        return lucideCache
    end
    local loaded = {}
    local ok, source = pcall(function()
        return game:HttpGet(LUCIDE_URL)
    end)
    if ok and type(source) == "string" then
        local compile = loadstring or load
        if compile then
            local okCompile, chunk = pcall(compile, source)
            if okCompile and type(chunk) == "function" then
                local okRun, result = pcall(chunk)
                if okRun and type(result) == "table" then loaded = result end
            end
        end
    end
    lucideCache = loaded
    runtimeEnv.__CustomUILucideIcons = loaded
    return loaded
end

