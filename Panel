        _transitionId = 0, _pageTweens = {}, _visibilityId = 0,
        _openPosition = UDim2.new(0.5, 0, 0.5, 0), _keybind = config.Keybind or Enum.KeyCode.RightAlt,
        _launcher = launcher, _launcherSize = 48, _resize = resizeHandle,
