function Section:AddSeperator(value)
    local title = type(value) == "table" and (value.Title or value[1]) or value
    if title == nil or tostring(title) == "" then
        return self:AddLine()
    end
    local header = self:AddParagraph({ Title = tostring(title) })
    header._frame.Size = UDim2.new(1, 0, 0, 18)
    return header
end

Section.AddSeparator = Section.AddSeperator

function NexusLib:DestroyAll()
    for _, window in ipairs(self._windows) do pcall(function() window:Destroy() end) end
    table.clear(self._windows)
    for _, child in ipairs(guiParent:GetChildren()) do
        if child:GetAttribute(PANEL_ATTRIBUTE) == true or child.Name == "CustomUINotifications" then child:Destroy() end
    end
end

