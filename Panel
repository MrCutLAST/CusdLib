local function gradientSequence(role, profile)
    local colors = profile.colors
    if role == "primary" then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, colors.primary2),
            ColorSequenceKeypoint.new(0.48, colors.primary),
            ColorSequenceKeypoint.new(1, colors.onPrimary),
        })
    elseif role == "surface" then
        return ColorSequence.new(colors.shellA, colors.shellB)
    elseif role == "canvas" then
        return ColorSequence.new(colors.canvasA, colors.canvasB)
    elseif role == "rail" then
        return ColorSequence.new(colors.rail, colors.shellB)
    end
    return ColorSequence.new(colors.primary2, colors.primary)
end

